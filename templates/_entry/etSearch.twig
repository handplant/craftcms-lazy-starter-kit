{% extends '_layouts/base' %}

{% block main %}
  {% cache using key 'entry__' ~ craft.app.request.pathInfo %}
    {% set search = craft.entries.section('search').one() %}

    <section class="ui-block ui-block-cke">
      <div class="ui-container prose md:prose-lg lg:prose-xl">
        {{ entry.builder }}
      </div>
    </section>
    <section class="ui-block ui-block-search">
      <div class="ui-container">
        {{ search.render({ type: 'page' }) }}
      </div>
    </section>
  {% endcache %}
{% endblock %}
