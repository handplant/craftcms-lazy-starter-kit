{% set builder = builder ?? false %}
{% extends builder ? '_partials/matrix.twig' : '_partials/cke.twig' %}
{% set classWrapper = (builder ? 'ui-block' : 'ui-inline') ~ ' ui-block-media' %}
{% set classContent = builder ? 'ui-container' : '' %}

{% block content %}
  {% include '_components/media.twig' with {
    asset: entry.assetMedia.eagerly().one() ?? null,
    showCaption: entry.mediaShowCaption
  } only %}
{% endblock %}
