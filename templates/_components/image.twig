{%- set _image = image ?? null -%}
{%- set _fetchpriority = fetchpriority ?? false -%}
{%- set _lazy = _fetchpriority ? false : lazy ?? true -%}
{%- set _sizes = sizes|default([768, 1536])|sort -%}
{%- set _sizesAttr = sizesAttr ?? '100vw' -%}
{%- set _aspectRatio = aspectRatio ?? '' -%}
{%- set _ratio = (ratio ?? '')|split(':') -%}
{%- set _hasRatio = (_ratio|length) == 2 and _ratio[0] > 0 and _ratio[1] > 0 -%}
{%- set _quality = quality ?? 85 -%}
{%- set _objectFit = objectFit ?? false -%}
{%- set _class = class ?? '' -%}
{%- set _pictureClass = pictureClass ?? '' -%}
{%- set _imgOnly = imgOnly ?? false -%}
{%- set _formats = formats ?? ['webp', 'jpeg'] -%}

{%- if _image -%}
  {%- set extension = _image.extension|lower -%}
  {%- set isTransformable = extension in ['png', 'jpg', 'jpeg', 'webp', 'avif']
    and extension in craft.app.images.supportedImageFormats
  -%}
  {%- set focalPoint = _image.getFocalPoint(true) ?? '50% 50%' -%}
  {%- set imageAttributes = {
    src: _image.url,
    class: (_aspectRatio ~ ' ' ~ _class)|trim ? : null,
    width: _image.width,
    height: _image.height,
    alt: _image.alt ?? '',
    fetchpriority: _fetchpriority ? 'high' : null,
    loading: _fetchpriority ? 'eager' : _lazy ? 'lazy' : null,
    decoding: _fetchpriority ? 'async' : null,
    style: _objectFit ? { height: '100%', width: '100%', 'object-fit': 'cover', 'object-position': focalPoint } : null
  } -%}

  {%- if isTransformable -%}
    {%- set outputFormats = {} -%}
    {%- if 'avif' in _formats and craft.app.images.getSupportsAvif() -%}
      {%- set outputFormats = outputFormats|merge({ avif: 'image/avif' }) -%}
    {%- endif -%}
    {%- if 'webp' in _formats and craft.app.images.getSupportsWebP() -%}
      {%- set outputFormats = outputFormats|merge({ webp: 'image/webp' }) -%}
    {%- endif -%}
    {%- if 'jpeg' in _formats -%}
      {%- set outputFormats = outputFormats|merge({ jpeg: 'image/jpeg' }) -%}
    {%- endif -%}

    {%- set fallbackFormat = 'jpeg' in _formats or extension == 'jpg' ? 'jpeg' : extension -%}
    {%- set outputFormats = outputFormats|merge({ (fallbackFormat): 'image/' ~ fallbackFormat }) -%}
    {%- set srcsets = {} -%}
    {%- set fallbackTransform = null -%}

    {%- for format, mimeType in outputFormats -%}
      {%- set candidates = {} -%}
      {%- for outputWidth in _sizes -%}
        {%- set transform = { width: outputWidth, quality: _quality, format: format } -%}
        {%- if _hasRatio -%}
          {%- set transform = transform|merge({ height: (outputWidth * _ratio[1] / _ratio[0])|round }) -%}
        {%- endif -%}
        {%- set actualWidth = _image.getWidth(transform) -%}
        {%- set candidates =
          candidates|merge({ ('w' ~ actualWidth): _image.getUrl(transform) ~ ' ' ~ actualWidth ~ 'w' })
        -%}
        {%- if format == fallbackFormat and loop.first -%}
          {%- set fallbackTransform = transform -%}
        {%- endif -%}
      {%- endfor -%}
      {%- set srcsets = srcsets|merge({ (format): candidates|join(', ') }) -%}
    {%- endfor -%}

    {%- set imageAttributes =
      imageAttributes|merge({
        src: _image.getUrl(fallbackTransform),
        srcset: srcsets[fallbackFormat],
        sizes: _sizesAttr,
        width: _image.getWidth(fallbackTransform),
        height: _image.getHeight(fallbackTransform)
      })
    -%}
  {%- endif -%}

  {%- if isTransformable and not _imgOnly -%}
    <picture {{ attr({ class: _pictureClass ? : null }) }}>
      {%- for format, mimeType in outputFormats -%}
        <source type="{{ mimeType }}" srcset="{{ srcsets[format] }}" sizes="{{ _sizesAttr }}" />
      {%- endfor -%}
      {{- tag('img', imageAttributes) -}}
    </picture>
  {%- else -%}
    {{- tag('img', imageAttributes) -}}
  {%- endif -%}
{%- endif -%}
